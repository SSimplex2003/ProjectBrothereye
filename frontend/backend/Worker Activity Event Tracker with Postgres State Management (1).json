    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const worker = $json.worker_name;\nconst activity = $json.activity_type;\nconst now = new Date($json.event_time);\n\nif (!worker || !activity || isNaN(now.getTime())) {\n  return { json: { shouldInsert: false, shouldUpsert: false, reason: \"Bad input\", in: $json } };\n}\n\nconst lastActivity = $json.last_activity;        // from activity_state\nconst lastStartRaw = $json.last_start_time;      // from activity_state\n\n// If no state yet => initialize state only\nif (!lastActivity || !lastStartRaw) {\n  return {\n    json: {\n      shouldInsert: false,\n      shouldUpsert: true,\n      reason: \"Initialized\",\n      upsert: {\n        worker_name: worker,\n        last_activity: activity,\n        last_start_time: now.toISOString(),\n        last_seen_time: now.toISOString(),\n      },\n    },\n  };\n}\n\nconst lastStart = new Date(lastStartRaw);\nif (isNaN(lastStart.getTime())) {\n  return {\n    json: {\n      shouldInsert: false,\n      shouldUpsert: true,\n      reason: \"Bad last_start_time in DB\",\n      upsert: {\n        worker_name: worker,\n        last_activity: activity,\n        last_start_time: now.toISOString(),\n        last_seen_time: now.toISOString(),\n      },\n    },\n  };\n}\n\n// No change => only update last_seen_time (keep same start)\nif (activity === lastActivity) {\n  return {\n    json: {\n      shouldInsert: false,\n      shouldUpsert: true,\n      reason: \"No change\",\n      upsert: {\n        worker_name: worker,\n        last_activity: lastActivity,\n        last_start_time: lastStart.toISOString(),\n        last_seen_time: now.toISOString(),\n      },\n    },\n  };\n}\n\n// Changed => insert previous activity row\nconst durationMinutes = Math.max(\n  0,\n  Math.round((now.getTime() - lastStart.getTime()) / 60000)\n);\n\nreturn {\n  json: {\n    shouldInsert: true,\n    shouldUpsert: true,\n    reason: \"Changed\",\n    insert: {\n      worker_name: worker,\n      activity_type: lastActivity,\n      duration_minutes: durationMinutes,\n      start_time: lastStart.toISOString(),\n      end_time: now.toISOString(),\n    },\n    upsert: {\n      worker_name: worker,\n      last_activity: activity,\n      last_start_time: now.toISOString(),\n      last_seen_time: now.toISOString(),\n    },\n  },\n};\n"
      },
