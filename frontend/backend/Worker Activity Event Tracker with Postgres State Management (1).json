      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  w.worker_name,\n  s.last_activity,\n  s.last_start_time\nFROM (SELECT $1::text AS worker_name) w\nLEFT JOIN activity_state s\n  ON s.worker_name = w.worker_name;\n",
