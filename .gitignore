# Python
.venv/
__pycache__/

# Local environment / secrets
.env

# Raw training videos: several GB and many exceed GitHub's 100 MB file limit.
# Keep them locally (or share them separately); the extracted crops below are
# committed instead.
actions_dataset/**/*.mov
actions_dataset/**/*.mp4
actions_dataset/**/*.avi
actions_dataset/**/*.mkv
actions_dataset/**/*.webm

# Oversampled copies are regenerated by the collect scripts
actions_dataset/*_crops/train/**/*_dup*.jpg
